# Salin ke .env lalu isi nilainya. File .env TIDAK ikut ter-commit.
#
# Di Kaggle, nilai-nilai ini TIDAK dibaca dari .env melainkan dari
# Kaggle Secrets (Add-ons -> Secrets di web UI; tidak ada dukungan CLI).
# Lihat train/common/env.py:get_secret() pada Task 12.

# Telegram alert sink (Task 10)
PFV_TELEGRAM_TOKEN=
PFV_TELEGRAM_CHAT_ID=

# Roboflow, hanya untuk jalur SEKUNDER Hard Hat Workers v5 (Task 13b)
PFV_ROBOFLOW_API_KEY=
